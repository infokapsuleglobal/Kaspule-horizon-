{%- doc -%}
  Kapsule brand layer on top of Horizon. Design tokens and bespoke component
  CSS matching the Kapsule design spec (canvas #F7F4EE, ink #1A1714, Spectral
  display type over a Helvetica Neue UI stack). Rendered at the end of <head>
  in layout/theme.liquid so it wins the cascade over Horizon's own styles.
{%- enddoc -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap"
  rel="stylesheet"
>

{% style %}
  :root {
    --font-body--family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --font-subheading--family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --font-heading--family: 'Spectral', Georgia, 'Times New Roman', serif;
    --font-accent--family: 'Spectral', Georgia, 'Times New Roman', serif;

    --kap-canvas: #F7F4EE;
    --kap-surface: #FCFAF6;
    --kap-surface-alt: #EFEBE1;
    --kap-ink: #1A1714;
    --kap-ink-2: #4A443E;
    --kap-ink-3: #9A9189;
    --kap-ink-4: #B0A89F;
    --kap-bordeaux: #5A1410;
    --kap-sand: #E9C9A8;
    --kap-band: #8A7A62;
    --kap-band-motif: #6B5B45;
    --kap-sage: #8FAE96;
    --kap-sage-ink: #15211A;
    --kap-hairline: rgba(26, 23, 20, 0.1);
    --kap-hairline-hover: rgba(26, 23, 20, 0.32);
    --kap-photo-placeholder: #F1EDE5;
  }

  body {
    background: var(--kap-canvas);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--kap-bordeaux);
  }

  ::selection {
    background: #E5006D;
    color: #fff;
  }

  /* ---------- Header logo ---------- */
  .header-logo {
    gap: 0;
  }

  #header-component {
    background: rgba(247, 244, 238, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--kap-hairline);
  }

  /* ---------- Pill buttons that adapt to whatever section they sit in ---------- */
  .kap-btn,
  .kap-btn--outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    padding: 15px 30px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    cursor: pointer;
    border: 1px solid transparent;
    transition: opacity 0.15s ease;
    font-family: var(--font-body--family);
  }

  .kap-btn {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .kap-btn--outline {
    background: transparent;
    color: var(--color-foreground);
    border-color: rgb(var(--color-foreground-rgb, 26 23 20) / 0.45);
  }

  .kap-btn:hover,
  .kap-btn--outline:hover {
    opacity: 0.82;
  }

  .kap-btn--sm {
    padding: 9px 16px;
    font-size: 12px;
    font-weight: 500;
  }

  /* ---------- Kicker pill / plain kicker ---------- */
  .kap-kicker {
    display: inline-block;
    border: 1px solid rgb(var(--color-foreground-rgb, 26 23 20) / 0.35);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .kap-eyebrow {
    display: block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kap-ink-3);
    margin-bottom: 4px;
  }

  .kap-italic {
    font-style: italic;
  }

  /* ---------- Greek-key band ---------- */
  .kap-meander {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    border-radius: 4px;
    background: var(--kap-band);
    min-block-size: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kap-meander__pattern {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 22px;
    padding-inline: 18px;
    z-index: 0;
  }

  .kap-meander__glyph {
    flex: 0 0 auto;
    inline-size: 44px;
    block-size: 44px;
    border: 8px solid var(--kap-band-motif);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kap-meander__glyph::after {
    content: '';
    inline-size: 11px;
    block-size: 11px;
    background: var(--kap-band-motif);
  }

  .kap-meander__pill {
    position: relative;
    z-index: 1;
    background: rgba(243, 239, 231, 0.94);
    border-radius: 999px;
    padding: clamp(5px, 1.1cqw, 8px) clamp(11px, 2.6cqw, 20px);
    font-family: var(--font-accent--family);
    font-style: italic;
    font-size: clamp(10px, 1.85cqw, 14px);
    color: #33291F;
    white-space: nowrap;
  }

  /* ---------- Concern tiles ---------- */
  .kap-concern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
  }

  .kap-concern-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 112px;
    padding: 18px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--kap-ink);
  }

  .kap-concern-tile__label {
    font-family: var(--font-heading--family);
    font-size: 19px;
    line-height: 1.2;
  }

  .kap-concern-tile__count {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--kap-ink-2);
  }

  /* ---------- Maisons panel ---------- */
  .kap-maisons {
    background: var(--kap-surface);
    border: 1px solid var(--kap-hairline);
    border-radius: 4px;
    padding: 26px 28px;
  }

  .kap-maisons__kicker {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--kap-ink-3);
    text-align: center;
    text-transform: uppercase;
  }

  .kap-maisons__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 34px;
    margin-top: 18px;
  }

  .kap-maisons__row a {
    font-family: var(--font-heading--family);
    font-size: 19px;
    color: var(--kap-ink-2);
    text-decoration: none;
  }

  .kap-maisons__row a:hover {
    color: var(--kap-bordeaux);
  }

  /* ---------- UGC grid ---------- */
  .kap-ugc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: 10px;
  }

  .kap-ugc-tile {
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    padding: 10px;
  }

  .kap-ugc-tile span {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 9px;
    color: rgba(26, 23, 20, 0.45);
  }

  /* ---------- Cart footer note ---------- */
  .kap-cart-foot-note {
    text-align: center;
    font-size: 11.5px;
    color: var(--kap-ink-3);
    margin: 10px 0 0;
  }

  /* ---------- Free shipping progress bar ---------- */
  .kap-shipbar {
    margin-top: 4px;
    margin-bottom: 14px;
  }

  .kap-shipbar__track {
    block-size: 4px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb, 26 23 20) / 0.12);
    overflow: hidden;
  }

  .kap-shipbar__fill {
    block-size: 100%;
    background: var(--kap-bordeaux);
    border-radius: 999px;
    transition: inline-size 0.3s ease;
  }

  .kap-shipbar__label {
    margin-top: 8px;
    font-size: 12px;
    color: var(--kap-ink-2);
  }

  /* ---------- Reassurance bullets ---------- */
  .kap-bullets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .kap-bullets li {
    font-size: 12px;
    border: 1px solid var(--kap-hairline);
    background: var(--kap-surface);
    border-radius: 999px;
    padding: 7px 13px;
    color: var(--kap-ink-2);
  }

  /* ---------- LA MAISON portrait ---------- */
  .kap-house {
    max-width: 820px;
  }

  .kap-house__kicker {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kap-ink-3);
  }

  .kap-house__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    margin: 10px 0 16px;
  }

  .kap-house__body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--kap-ink-2);
    margin: 0;
  }

  /* ---------- Product info accordion (Actifs / Texture / Livraison) ---------- */
  .kap-panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }

  .kap-panel {
    border: 1px solid var(--kap-hairline);
    border-radius: 4px;
    padding: 20px 22px;
  }

  .kap-panel summary {
    cursor: pointer;
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 17px;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kap-panel summary::-webkit-details-marker {
    display: none;
  }

  .kap-panel summary::after {
    content: '+';
    font-family: var(--font-body--family);
    font-size: 18px;
    font-style: normal;
    color: var(--kap-ink-3);
  }

  .kap-panel[open] summary::after {
    content: '−';
  }

  .kap-panel__body {
    margin-top: 12px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--kap-ink-2);
  }

  /* ---------- Bundle (same-house routine) ---------- */
  .kap-bundle {
    background: var(--kap-surface-alt);
    border-radius: 4px;
    padding: 24px;
  }

  .kap-bundle__title {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 19px;
    margin: 0 0 14px;
  }

  .kap-bundle__items {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 16px;
  }

  .kap-bundle__item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--kap-surface);
    border-radius: 4px;
    padding: 8px 12px 8px 8px;
  }

  .kap-bundle__item img {
    inline-size: 44px;
    block-size: 44px;
    object-fit: cover;
    border-radius: 3px;
    background: var(--kap-photo-placeholder);
  }

  .kap-bundle__item-name {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 13px;
    line-height: 1.3;
  }

  .kap-bundle__item-price {
    font-size: 11.5px;
    color: var(--kap-ink-2);
  }

  .kap-bundle__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .kap-bundle__total {
    font-size: 13px;
  }

  .kap-bundle__total strong {
    font-size: 18px;
  }

  /* ---------- Sticky add-to-cart bar (PDP) ---------- */
  .kap-sticky-atc {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    background: rgba(252, 250, 246, 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--kap-hairline);
    padding: 12px max(16px, calc((100% - 1440px) / 2 + 28px));
    display: flex;
    align-items: center;
    gap: 14px;
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .kap-sticky-atc.is-visible {
    transform: translateY(0);
  }

  .kap-sticky-atc__media {
    inline-size: 42px;
    block-size: 42px;
    border-radius: 3px;
    object-fit: cover;
    flex: 0 0 auto;
    background: var(--kap-photo-placeholder);
  }

  .kap-sticky-atc__info {
    flex: 1;
    min-width: 0;
  }

  .kap-sticky-atc__name {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kap-sticky-atc__price {
    font-size: 12.5px;
    color: var(--kap-ink-2);
  }

  body:has(.kap-sticky-atc.is-visible) {
    padding-bottom: 74px;
  }

  @media screen and (max-width: 749px) {
    .kap-sticky-atc {
      padding: 10px 16px;
    }

    /* Homepage bestsellers: 4 on mobile instead of 8, per spec. */
    #shopify-section-kap_bestsellers .resource-list__item:nth-child(n + 5) {
      display: none;
    }
  }
{% endstyle %}
