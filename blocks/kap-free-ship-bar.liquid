{% liquid
  assign threshold = 49
  assign threshold_cents = threshold | times: 100
  assign pct = cart.total_price | times: 100 | divided_by: threshold_cents
  if pct > 100
    assign pct = 100
  endif
  assign remaining = threshold_cents | minus: cart.total_price
%}

<div class="kap-shipbar" data-kap-shipbar data-threshold-cents="{{ threshold_cents }}" {{ block.shopify_attributes }}>
  <div class="kap-shipbar__track">
    <div class="kap-shipbar__fill" data-kap-shipbar-fill style="inline-size: {{ pct }}%;"></div>
  </div>
  <p class="kap-shipbar__label" data-kap-shipbar-label>
    {% if remaining <= 0 %}
      Livraison offerte 🎉
    {% else %}
      Livraison offerte dès 49&nbsp;€ — encore {{ remaining | money }}
    {% endif %}
  </p>
</div>

<script src="{{ 'kap-free-ship-bar.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "Kapsule free-shipping bar",
  "settings": []
}
{% endschema %}
