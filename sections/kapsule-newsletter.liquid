{% liquid
  assign bg = section.settings.color_background
  render 'contrast-override', background_color: bg, section_id: section.id
%}

<div
  class="section section--page-width spacing-style page-width color-custom-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="kap-newsletter">
    <div>
      <p class="kap-newsletter__title">{{ section.settings.heading }}</p>
      <p class="kap-newsletter__body">{{ section.settings.body }}</p>
    </div>
    <div class="kap-newsletter__form-wrap">
      {% form 'customer', id: 'kap-newsletter-form', class: 'kap-newsletter__form' %}
        {% if form.posted_successfully? %}
          <p class="kap-newsletter__done">{{ section.settings.success_label }}</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder }}"
            required
            class="kap-newsletter__input"
          >
          <button type="submit" class="kap-btn">{{ section.settings.cta }}</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .kap-newsletter {
    background: var(--kap-sage, #8FAE96);
    color: var(--kap-sage-ink, #15211A);
    border-radius: 5px;
    padding: 34px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 24px;
    align-items: center;
  }

  .kap-newsletter__title {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 26px;
    margin: 0;
  }

  .kap-newsletter__body {
    font-size: 14px;
    line-height: 1.6;
    margin: 10px 0 0;
    max-width: 440px;
  }

  .kap-newsletter__form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .kap-newsletter__input {
    flex: 1;
    min-width: 200px;
    border: 1px solid rgba(21, 33, 26, 0.35);
    background: rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    padding: 14px 20px;
    font-size: 14px;
    outline: none;
    color: #15211A;
  }

  .kap-newsletter__done {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 16px;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kapsule newsletter",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Les nouveautés avant tout le monde" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Drops, restocks et sélections du pop-up — une lettre par mois, jamais plus."
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Votre e-mail" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "S'inscrire" },
    { "type": "text", "id": "success_label", "label": "Success message", "default": "Merci ✓" },
    { "type": "color", "id": "color_background", "label": "Background colour", "default": "#8FAE96" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Kapsule newsletter",
      "category": "Kapsule"
    }
  ]
}
{% endschema %}
