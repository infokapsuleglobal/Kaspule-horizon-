<div
  class="section section--page-width spacing-style page-width"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% if section.settings.heading != blank %}
    <h2 class="h3" style="font-family: var(--font-heading--family); font-weight: 400; margin: 0 0 8px;">
      {{ section.settings.heading }}
    </h2>
  {% endif %}
  <div class="kap-list-rows">
    {% for block in section.blocks %}
      <div class="kap-list-row" {{ block.shopify_attributes }}>
        <span class="kap-list-row__label">{{ block.settings.label }}</span>
        <span class="kap-list-row__meta">{{ block.settings.meta }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule list rows",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Céramique de Séoul" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Jusqu'au 12 octobre" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sélections en cours" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Kapsule list rows",
      "category": "Kapsule",
      "blocks": {
        "row_1": { "type": "row", "settings": { "label": "Céramique de Séoul", "meta": "Jusqu'au 12 octobre" } },
        "row_2": { "type": "row", "settings": { "label": "Studio Textile — édition capsule", "meta": "Nouveau cette semaine" } },
        "row_3": { "type": "row", "settings": { "label": "Papeterie & objets — jeunes créateurs", "meta": "Permanent" } }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
