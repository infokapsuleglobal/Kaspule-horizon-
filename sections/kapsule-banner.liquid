{% liquid
  assign bg = section.settings.color_background
  assign bg2 = section.settings.color_gradient
  assign has_bg = false
  if bg != blank
    assign has_bg = true
    render 'contrast-override', background_color: bg, section_id: section.id
  endif
%}

<div class="section-background{% if has_bg %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="
    section section--full-width spacing-style kap-banner kap-banner--{{ section.settings.layout }}
    {% if section.settings.content_align == 'center' %}kap-banner--center{% endif %}
    {% if has_bg %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if has_bg and bg2 != blank %}
      {% if section.settings.color_gradient_mid != blank %}
        background-image: linear-gradient({{ section.settings.gradient_angle }}deg, {{ bg }} 0%, {{ section.settings.color_gradient_mid }} 45%, {{ bg2 }} 100%);
      {% else %}
        background-image: linear-gradient({{ section.settings.gradient_angle }}deg, {{ bg }} 0%, {{ bg2 }} 100%);
      {% endif %}
    {% endif %}
  "
>
  <div class="kap-banner__inner page-width">
    <div class="kap-banner__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'kicker' %}
            <span class="kap-kicker" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {% when 'heading' %}
            <div class="kap-banner__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {% when 'text' %}
            <div class="kap-banner__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {% when 'button' %}
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="{% if block.settings.style == 'outline' %}kap-btn--outline{% else %}kap-btn{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'side_panel' %}
        <div
          class="kap-banner__side"
          {% if block.settings.image != blank %}
            style="background-image: url({{ block.settings.image | image_url: width: 900 }});"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image == blank and block.settings.caption != blank %}
            <span class="kap-banner__side-caption">{{ block.settings.caption }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% if block.type == 'hero_products' %}
        {% liquid
          assign hero_collection = block.settings.collection
          if hero_collection == blank
            assign hero_collection = collections.all
          endif
        %}
        <div class="kap-hero-products" {{ block.shopify_attributes }}>
          {% for product in hero_collection.products limit: 4 %}
            <a href="{{ product.url }}" class="kap-hero-products__card">
              <div class="kap-hero-products__media">
                {{
                  product.featured_image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 220px, 45vw', class: 'kap-hero-products__img'
                }}
                <span class="kap-hero-products__brand">{{ product.vendor }}</span>
              </div>
              <div class="kap-hero-products__body">
                <span class="kap-hero-products__name">{{ product.title }}</span>
                <span class="kap-hero-products__price">{{ product.price | money }}</span>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .kap-banner {
    overflow: hidden;
    container-type: inline-size;
  }

  .kap-banner--full .kap-banner__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    padding-block: clamp(26px, 4.6cqw, 70px);
  }

  .kap-banner--full:has(.kap-banner__side, .kap-hero-products) .kap-banner__inner {
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  }

  .kap-banner--full .kap-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .kap-banner--center .kap-banner__inner {
    justify-items: center;
    text-align: center;
  }

  .kap-banner--center .kap-banner__content {
    align-items: center;
  }

  .kap-banner--center .kap-banner__text {
    max-width: 56ch;
  }

  .kap-banner--full .kap-banner__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(30px, 6cqw, 62px);
    line-height: 1.06;
    margin: 6px 0 0;
  }

  .kap-banner--full .kap-banner__heading em {
    font-style: italic;
    color: var(--kap-tan);
  }

  .kap-banner--full .kap-banner__text {
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.65;
    opacity: 0.82;
    margin-top: 4px;
  }

  .kap-banner--full .kap-banner__content > .kap-btn,
  .kap-banner--full .kap-banner__content > .kap-btn--outline {
    margin-top: 14px;
  }

  .kap-banner__side {
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    border-radius: 6px;
    min-height: 220px;
    background-size: cover;
    background-position: center;
    background-color: rgb(var(--color-foreground-rgb, 26 23 20) / 0.08);
    padding: 16px;
  }

  .kap-banner__side-caption {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .kap-hero-products {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .kap-hero-products__card {
    display: block;
    background: var(--kap-surface, #FCFAF6);
    border-radius: 5px;
    overflow: hidden;
    text-decoration: none;
    color: var(--kap-ink, #1A1714);
  }

  .kap-hero-products__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--kap-photo-placeholder, #F1EDE5);
    display: flex;
    align-items: flex-end;
    padding: 10px;
    overflow: hidden;
  }

  .kap-hero-products__img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .kap-hero-products__brand {
    position: relative;
    background: var(--kap-surface, #FCFAF6);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .kap-hero-products__body {
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .kap-hero-products__name {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 13px;
    line-height: 1.3;
  }

  .kap-hero-products__price {
    font-size: 12px;
    color: var(--kap-ink-2, #4A443E);
  }

  .kap-banner--bar .kap-banner__inner {
    padding-block: 18px;
  }

  .kap-banner--bar .kap-banner__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .kap-banner--bar .kap-banner__text {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 17px;
    margin: 0;
  }

  .kap-banner--bar .kap-banner__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-style: italic;
    font-size: 22px;
    margin: 0;
  }

  .kap-banner--bar .kap-banner__content > .kap-banner__heading + .kap-banner__text {
    font-style: normal;
    font-size: 13.5px;
    opacity: 0.8;
    max-width: 46ch;
    margin-top: 6px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kapsule banner",
  "tag": "section",
  "class": "kap-banner-wrapper section-wrapper",
  "blocks": [
    {
      "type": "kicker",
      "name": "Kicker",
      "settings": [
        { "type": "text", "id": "text", "label": "Kicker text", "default": "KAPSULE" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Heading",
          "info": "Italicize a word in the editor to render it in the accent tan colour.",
          "default": "<p>Curated &amp; <em>premium</em> Korean brands</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Body text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        }
      ]
    },
    {
      "type": "side_panel",
      "name": "Side panel (image placeholder)",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Édition en cours" }
      ]
    },
    {
      "type": "hero_products",
      "name": "Hero product grid (2x2, real products)",
      "limit": 1,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to pull from all products." }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Full banner" },
        { "value": "bar", "label": "Slim bar" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background colour",
      "default": "#5A1410"
    },
    {
      "type": "color",
      "id": "color_gradient_mid",
      "label": "Gradient middle colour (optional, 3-stop)"
    },
    {
      "type": "color",
      "id": "color_gradient",
      "label": "Gradient end colour (optional)",
      "default": "#1C1512"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 115
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Kapsule hero banner",
      "category": "Kapsule",
      "settings": { "layout": "full" },
      "blocks": {
        "kicker": { "type": "kicker", "settings": { "text": "MAISON DE SÉLECTION — PARIS" } },
        "heading": {
          "type": "heading",
          "settings": { "text": "<p>Curated &amp; <em>Premium</em> Korean Brands</p>" }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Le pont entre l'élégance parisienne et l'avant-garde coréenne — soin, rituel et style, réunis au cœur du Marais.</p>"
          }
        },
        "button": { "type": "button", "settings": { "label": "Découvrir la sélection", "style": "solid" } }
      },
      "block_order": ["kicker", "heading", "text", "button"]
    },
    {
      "name": "Kapsule CTA bar",
      "category": "Kapsule",
      "settings": { "layout": "bar", "color_background": "#8FAE96", "color_gradient": "" },
      "blocks": {
        "text": { "type": "text", "settings": { "text": "<p>Livraison offerte en France dès 49€ d'achat</p>" } },
        "button": { "type": "button", "settings": { "label": "En savoir plus", "style": "solid" } }
      },
      "block_order": ["text", "button"]
    }
  ]
}
{% endschema %}
