<div
  class="section section--page-width spacing-style page-width"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;flex-wrap:wrap">
    {% if section.settings.heading != blank %}
      <h2 style="font-family:var(--font-heading--family);font-weight:400;font-size:clamp(24px,3vw,32px);margin:0">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <span style="font-size:13px;color:var(--kap-ink-3)">{{ section.settings.subheading }}</span>
    {% endif %}
  </div>
  <div class="kap-concern-grid" style="margin-top:20px">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="kap-concern-tile"
        style="background:{{ block.settings.background }};"
        {{ block.shopify_attributes }}
      >
        <span class="kap-concern-tile__label">{{ block.settings.label }}</span>
        <span class="kap-concern-tile__count">{{ block.settings.count }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule concern tiles",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Éclat & teint terne" },
        { "type": "text", "id": "count", "label": "Count label", "default": "8 produits" },
        { "type": "color", "id": "background", "label": "Background", "default": "#F1E8EC" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Par besoin de peau" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Trouvez en deux clics" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kapsule concern tiles",
      "category": "Kapsule",
      "blocks": {
        "t1": { "type": "tile", "settings": { "label": "Éclat & teint terne", "background": "#F1E8EC" } },
        "t2": { "type": "tile", "settings": { "label": "Rides & fermeté", "background": "#E9EAE2" } },
        "t3": { "type": "tile", "settings": { "label": "Sécheresse", "background": "#EDE6DC" } },
        "t4": { "type": "tile", "settings": { "label": "Peau sensible", "background": "#E6EDEA" } },
        "t5": { "type": "tile", "settings": { "label": "Rougeurs", "background": "#F0E9E3" } }
      },
      "block_order": ["t1", "t2", "t3", "t4", "t5"]
    }
  ]
}
{% endschema %}
