{
  "sections": {
    "kap_hero": {
      "type": "kapsule-banner",
      "blocks": {
        "kicker": { "type": "kicker", "settings": { "text": "MAISON DE SÉLECTION — PARIS" } },
        "heading": {
          "type": "heading",
          "settings": { "text": "<p>Curated &amp; <em>Premium</em> Korean Brands</p>" }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Le pont entre l'élégance parisienne et l'avant-garde coréenne — soin, rituel et style, réunis au cœur du Marais.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": { "label": "Découvrir la sélection", "link": "shopify://collections/all", "style": "solid" }
        },
        "side": {
          "type": "side_panel",
          "settings": { "caption": "Édition en cours" }
        }
      },
      "block_order": ["kicker", "heading", "text", "button", "side"],
      "settings": {
        "layout": "full",
        "color_background": "#5A1410",
        "color_gradient": "#1C1512",
        "gradient_angle": 105,
        "padding-block-start": 24,
        "padding-block-end": 0
      }
    },
    "kap_features": {
      "type": "kapsule-feature-cards",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "kicker": "01 — KAPSULE PALAIS",
            "title": "L'Institut",
            "body": "La K-Esthétique, portée par l'héritage de Jiwon Hong et sa méthode de récupération structurelle.",
            "link_label": "Découvrir",
            "link": "shopify://pages/institut"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "kicker": "02 — L'UNIVERS BOUTIQUE",
            "title": "La Boutique",
            "body": "15 maisons de cosmétiques coréennes, choisies pour la noblesse de leurs actifs.",
            "link_label": "Explorer",
            "link": "shopify://collections/all"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "kicker": "03 — POP-UP STORE",
            "title": "Le Pop-up",
            "body": "Une sélection tournante de créateurs émergents et de pièces lifestyle rares.",
            "link_label": "Visiter",
            "link": "shopify://pages/pop-up"
          }
        }
      },
      "block_order": ["card_1", "card_2", "card_3"],
      "settings": {
        "padding-block-start": 24,
        "padding-block-end": 0
      }
    },
    "kap_meander": {
      "type": "kapsule-meander-band",
      "settings": {
        "text": "Le soin, le rituel et le style — l'excellence coréenne",
        "padding-block-start": 22,
        "padding-block-end": 0
      }
    },
    "kap_bestsellers": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h3>Les incontournables de la sélection</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-heading--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_list_button": {
              "type": "_product-list-button",
              "name": "t:names.product_list_button",
              "settings": {
                "label": "Voir tout",
                "open_in_new_tab": false,
                "style_class": "button-unstyled",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            }
          },
          "block_order": ["product_list_text", "product_list_button"]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 4,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["product_card_gallery", "product_title", "price"]
        }
      },
      "name": "t:names.featured_collection",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 16,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 22,
        "padding-block-start": 44,
        "padding-block-end": 0
      }
    },
    "kap_delivery_bar": {
      "type": "kapsule-banner",
      "blocks": {
        "text": { "type": "text", "settings": { "text": "<p>Livraison offerte en France dès 49€ d'achat</p>" } },
        "button": { "type": "button", "settings": { "label": "En savoir plus", "link": "shopify://pages/notre-vision", "style": "solid" } }
      },
      "block_order": ["text", "button"],
      "settings": {
        "layout": "bar",
        "color_background": "#8FAE96",
        "color_gradient": "",
        "padding-block-start": 44,
        "padding-block-end": 56
      }
    }
  },
  "order": ["kap_hero", "kap_features", "kap_meander", "kap_bestsellers", "kap_delivery_bar"]
}
