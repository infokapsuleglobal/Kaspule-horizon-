{
  "sections": {
    "kap_hero": {
      "type": "kapsule-banner",
      "blocks": {
        "kicker": { "type": "kicker", "settings": { "text": "MAISON DE SÉLECTION — PARIS" } },
        "heading": {
          "type": "heading",
          "settings": { "text": "<p>Curated &amp; <em>Premium</em> Korean Brands</p>" }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Le pont entre l'élégance parisienne et l'avant-garde coréenne — une curation exigeante de maisons coréennes, au cœur du Marais.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": { "label": "Découvrir la sélection", "link": "shopify://collections/all", "style": "solid" }
        },
        "button2": {
          "type": "button",
          "settings": { "label": "Trouver ma routine", "link": "shopify://collections/all", "style": "outline" }
        },
        "products": {
          "type": "hero_products",
          "settings": { "collection": "" }
        }
      },
      "block_order": ["kicker", "heading", "text", "button", "button2", "products"],
      "settings": {
        "layout": "full",
        "color_background": "#5A1410",
        "color_gradient_mid": "#3A1310",
        "color_gradient": "#1C1512",
        "gradient_angle": 105,
        "padding-block-start": 24,
        "padding-block-end": 0
      }
    },
    "kap_meander": {
      "type": "kapsule-meander-band",
      "settings": {
        "text": "Soin · Rituel · Style",
        "padding-block-start": 22,
        "padding-block-end": 0
      }
    },
    "kap_concerns": {
      "type": "kapsule-concern-tiles",
      "blocks": {
        "t1": {
          "type": "tile",
          "settings": {
            "label": "Éclat & teint terne",
            "count": "19 produits",
            "background": "#F1E8EC",
            "link": "/collections/all?filter.p.tag=concern:Radiance"
          }
        },
        "t2": {
          "type": "tile",
          "settings": {
            "label": "Rides & fermeté",
            "count": "7 produits",
            "background": "#E9EAE2",
            "link": "/collections/all?filter.p.tag=concern:Firmness"
          }
        },
        "t3": {
          "type": "tile",
          "settings": {
            "label": "Sécheresse",
            "count": "19 produits",
            "background": "#EDE6DC",
            "link": "/collections/all?filter.p.tag=concern:Dryness"
          }
        },
        "t4": {
          "type": "tile",
          "settings": {
            "label": "Peau sensible",
            "count": "19 produits",
            "background": "#E6EDEA",
            "link": "/collections/all?filter.p.tag=concern:Sensitive"
          }
        },
        "t5": {
          "type": "tile",
          "settings": {
            "label": "Rougeurs",
            "count": "3 produits",
            "background": "#F0E9E3",
            "link": "/collections/all?filter.p.tag=concern:Redness"
          }
        }
      },
      "block_order": ["t1", "t2", "t3", "t4", "t5"],
      "settings": {
        "heading": "Par besoin de peau",
        "subheading": "Trouvez en deux clics",
        "padding-block-start": 44,
        "padding-block-end": 0
      }
    },
    "kap_bestsellers": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h3>Les incontournables de la sélection</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-heading--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_list_button": {
              "type": "_product-list-button",
              "name": "t:names.product_list_button",
              "settings": {
                "label": "Voir tout",
                "open_in_new_tab": false,
                "style_class": "button-unstyled",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            }
          },
          "block_order": ["product_list_text", "product_list_button"]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "portrait",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 4,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-heading--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["product_card_gallery", "product_title", "price"]
        }
      },
      "name": "t:names.featured_collection",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 16,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 22,
        "padding-block-start": 44,
        "padding-block-end": 0
      }
    },
    "kap_maisons": {
      "type": "kapsule-maisons",
      "blocks": {
        "h1": { "type": "house", "settings": { "name": "ZISU'C", "link": "/collections/all?filter.p.vendor=ZISU'C" } },
        "h2": { "type": "house", "settings": { "name": "Urang", "link": "/collections/all?filter.p.vendor=Urang" } },
        "h3": { "type": "house", "settings": { "name": "VT Cosmetics", "link": "/collections/all?filter.p.vendor=VT Cosmetics" } },
        "h4": { "type": "house", "settings": { "name": "Mixsoon", "link": "/collections/all?filter.p.vendor=Mixsoon" } },
        "h5": { "type": "house", "settings": { "name": "Glash", "link": "/collections/all?filter.p.vendor=Glash" } },
        "h6": { "type": "house", "settings": { "name": "rom&nd", "link": "/collections/all?filter.p.vendor=rom&nd" } },
        "h7": { "type": "house", "settings": { "name": "Tocobo", "link": "/collections/all?filter.p.vendor=Tocobo" } },
        "h8": { "type": "house", "settings": { "name": "d'Alba", "link": "/collections/all?filter.p.vendor=d'Alba" } }
      },
      "block_order": ["h1", "h2", "h3", "h4", "h5", "h6", "h7", "h8"],
      "settings": {
        "kicker": "LES MAISONS DE LA SÉLECTION",
        "padding-block-start": 44,
        "padding-block-end": 0
      }
    },
    "kap_institut_teaser": {
      "type": "kapsule-banner",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": { "text": "<p>Là où la K-Beauty laisse place à la K-Esthétique</p>" }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>La méthode de Jiwon Hong, 34 ans de pratique — réalignement, circulation, restauration structurelle.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": { "label": "Réserver un soin", "link": "shopify://pages/institut", "style": "solid" }
        }
      },
      "block_order": ["heading", "text", "button"],
      "settings": {
        "layout": "full",
        "color_background": "#5A1410",
        "color_gradient_mid": "#2A1512",
        "color_gradient": "#1C1512",
        "gradient_angle": 115,
        "padding-block-start": 32,
        "padding-block-end": 0
      }
    },
    "kap_ugc": {
      "type": "kapsule-ugc-grid",
      "blocks": {
        "u1": { "type": "tile", "settings": { "tint": "#F1E8EC" } },
        "u2": { "type": "tile", "settings": { "tint": "#E9EAE2" } },
        "u3": { "type": "tile", "settings": { "tint": "#EDE6DC" } },
        "u4": { "type": "tile", "settings": { "tint": "#E6EDEA" } },
        "u5": { "type": "tile", "settings": { "tint": "#F0E9E3" } },
        "u6": { "type": "tile", "settings": { "tint": "#EFEBE1" } }
      },
      "block_order": ["u1", "u2", "u3", "u4", "u5", "u6"],
      "settings": {
        "heading": "Le Marais, en ce moment",
        "handle": "@kapsule.paris",
        "padding-block-start": 44,
        "padding-block-end": 0
      }
    },
    "kap_newsletter": {
      "type": "kapsule-newsletter",
      "settings": {
        "heading": "Les nouveautés avant tout le monde",
        "body": "Drops, restocks et sélections du pop-up — une lettre par mois, jamais plus.",
        "placeholder": "Votre e-mail",
        "cta": "S'inscrire",
        "success_label": "Merci ✓",
        "color_background": "#8FAE96",
        "padding-block-start": 44,
        "padding-block-end": 56
      }
    }
  },
  "order": [
    "kap_hero",
    "kap_meander",
    "kap_concerns",
    "kap_bestsellers",
    "kap_maisons",
    "kap_ugc",
    "kap_institut_teaser",
    "kap_newsletter"
  ]
}
